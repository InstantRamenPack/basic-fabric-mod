{
	"schemaVersion": 1,
	"id": "squirrel",
	"version": "${version}",
	"name": "Squirrel",
	"description": "Squirrel Fabric mod adding squirrels to Minecraft. Made as a project for CS SWE 1.",
	"authors": [
		"InstantRamenPack",
		"spkbreadroll",
		"Atomic4now"
	],
	"contact": {
		"homepage": "https://github.com/InstantRamenPack/basic-fabric-mod",
		"sources": "https://github.com/InstantRamenPack/basic-fabric-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/squirrel/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.modroll.squirrel.Squirrel"
		],
		"client": [
			"dev.modroll.squirrel.SquirrelClient"
		]
	},
	"mixins": [
		"squirrel.mixins.json",
		{
			"config": "squirrel.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
